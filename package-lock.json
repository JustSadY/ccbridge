{
  "name": "ccbridge-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ccbridge-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@ccbridge/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@ccbridge/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@ccbridge/cli",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@ccbridge/core": "*"
      },
      "bin": {
        "ccbridge": "src/cli.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/core": {
      "name": "@ccbridge/core",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    }
  }
}
